# Optional: used to turn forensic signals into plain-language explanations.
# Leave blank to use the built-in explainer (no network call).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Max download size when analyzing a URL (bytes)
MAX_DOWNLOAD_BYTES=25000000

# CORS origins (comma-separated). Default allows local frontend.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
